[Unit]
Description=Revenue Inbox Harvester queue worker
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/email-permutation-engine/webapp
EnvironmentFile=/opt/email-permutation-engine/webapp/.env
ExecStart=/opt/email-permutation-engine/.venv/bin/python -u worker.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
